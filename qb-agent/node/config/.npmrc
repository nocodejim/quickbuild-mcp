# NPM Configuration for QuickBuild Agent
cache=/opt/qb-agent/.npm
# No "prefix" here: nvm refuses to run with an npm prefix/globalconfig setting;
# global packages live in the nvm-managed Node.js directory.
init-author-name=QuickBuild Agent
init-license=MIT
save-exact=true
engine-strict=true
fund=false
audit-level=moderate
