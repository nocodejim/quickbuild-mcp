# QuickBuild 16 Containerization & MCP Server Environment Variables
# Copy this file to .env and update with your values

# =============================================================================
# QUICKBUILD MCP SERVER CONFIGURATION
# =============================================================================

# Full reference: docs/CONFIGURATION.md ("MCP Server Configuration")

# QuickBuild server URL for the MCP server (use http://qb-server:8810 inside Docker network)
QB_URL=http://localhost:8810

# QuickBuild REST API credentials for the MCP server
# (the administrator account created in the QuickBuild first-run setup wizard; use a dedicated
# service account against a real server)
QB_USER=admin
QB_PASSWORD=your_qb_password
# Or read the password from a mounted secret file (wins over QB_PASSWORD):
# QB_PASSWORD_FILE=/run/secrets/qb_password

# REST authentication mode:
#   basic   - HTTP Basic QB_USER:QB_PASSWORD on every request (the QuickBuild REST API scheme)
#   token   - HTTP Basic QB_USER:QB_TOKEN with the user's QuickBuild access token (no password)
#   session - legacy POST /rest/authentication login, only for proxies that provide it
QB_AUTH_MODE=basic
# QB_TOKEN=
# QB_TOKEN_FILE=/run/secrets/qb_token

# TLS: verify QuickBuild's certificate; add a corporate CA bundle (PEM file or directory)
QB_VERIFY_SSL=true
# QB_CA_BUNDLE=/etc/ssl/corp/ca-bundle.pem

# Seconds to wait for QuickBuild per request
QB_TIMEOUT=30

# Egress proxy (standard variables; NO_PROXY takes host names, domains and IPs, not CIDR ranges)
# HTTPS_PROXY=http://proxy.corp.example:3128
# NO_PROXY=quickbuild.corp.example,localhost

# Read-only mode: hide and refuse builds.trigger, build_requests.cancel and system.backup_database
QB_READ_ONLY=false

# Server-side directory used by system.backup_database when no backup_path is given
QB_BACKUP_DIR=/opt/quickbuild/data/backup

# MCP transport: stdio (default) or http (Streamable HTTP at http://<host>:MCP_PORT/mcp with
# /health and /ready; the compose service runs http)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=14002
# Host headers accepted by the HTTP transport (DNS-rebinding protection), e.g. the gateway's name
# MCP_ALLOWED_HOSTS=quickbuild-mcp.corp:*,localhost:*
# MCP_ALLOWED_ORIGINS=https://gateway.corp.example
LOG_LEVEL=INFO

# Optional TTL caches (seconds; set to 0 to disable)
QB_CACHE_TTL_CONFIGS=300
QB_CACHE_TTL_AGENTS=30

# =============================================================================
# DATABASE CONFIGURATION (Microsoft SQL Server)
# =============================================================================

# SQL Server SA (System Administrator) password
# Must be at least 8 characters with uppercase, lowercase, number, and special character
MSSQL_SA_PASSWORD=YourStrongPassword123!

# QuickBuild database user password
# Used by QB server to connect to database
QB_DB_PASSWORD=QBUserPassword123!

# SQL Server Product ID (Express = free edition)
MSSQL_PID=Express

# SQL Server Collation
MSSQL_COLLATION=SQL_Latin1_General_CP1_CI_AS

# =============================================================================
# QUICKBUILD SERVER CONFIGURATION
# =============================================================================

# Database connection settings
QB_DB_TYPE=mssql
QB_DB_HOST=qb-database
QB_DB_PORT=1433
QB_DB_NAME=quickbuild
QB_DB_USER=qb_user

# QuickBuild server URL (used by agents to connect)
QB_SERVER_URL=http://qb-server:8810

# Server HTTP port
QB_SERVER_PORT=8810

# Global storage directory to enter in the setup wizard (must be outside /opt/quickbuild)
# QB_STORAGE_DIR=/var/lib/quickbuild/storage

# Optional JVM max heap (MB) for the QuickBuild server
# QB_JAVA_MAX_MEMORY_MB=2048

# =============================================================================
# IMAGE BUILD ARGUMENTS (optional; Dockerfile defaults are used when unset)
# =============================================================================

# JDK_IMAGE=eclipse-temurin:21-jdk-noble
# QB_VERSION=16.0.37
# QB_DOWNLOAD_URL=https://pmease.com/artifacts/6371/quickbuild-16.0.37.zip
# QB_DOWNLOAD_SHA256=bfbc7e5316de80a54cd007b8e2bca3600ed23f8642d7e5e2f4bcfda4d6001240
# MSSQL_JDBC_VERSION=13.6.2.jre11
# MSSQL_JDBC_SHA256=5fbc0a70fe4d1d563d431a41b23f493d68807571f0bb49db0bb1737e83e9161f
# MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2025-CU11-ubuntu-24.04

# =============================================================================
# BUILD AGENT CONFIGURATION
# =============================================================================

# Agent communication port
AGENT_PORT=8811

# QuickBuild 16 agents need a token in node.properties. One is generated per container and kept
# across restarts; new agents must be authorized on the Grid page (or /rest/tokens/authorize).
# Set per agent (not shared between replicas) to keep an identity when containers are recreated.
# QB_AGENT_TOKEN=

# Number of agents to start (for scaling)
AGENT_REPLICAS=2

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================

# Docker Compose project name (prefixes volume names; use quickbuild14 to keep older volumes)
COMPOSE_PROJECT_NAME=quickbuild

# Network subnet for qb-net (pick a free range if compose reports "Pool overlaps")
QB_NETWORK_SUBNET=172.20.0.0/16

# =============================================================================
# END-TO-END TEST HARNESS (scripts/e2e.sh; these are its defaults)
# =============================================================================
# The e2e script never reads this .env file: it writes its own per-run env file with generated
# passwords under .e2e/<project>/. Override these in the shell when they collide on your host.
# E2E_PROJECT=qbe2e
# E2E_QB_PORT=18810
# E2E_MCP_PORT=14012
# E2E_TLS_PORT=18843
# QB_NETWORK_SUBNET=10.221.0.0/16

# =============================================================================
# KUBERNETES CONFIGURATION
# =============================================================================

# Kubernetes namespace
QB_NAMESPACE=quickbuild

# Storage class for persistent volumes
QB_STORAGE_CLASS=standard

# Database storage size
DB_STORAGE_SIZE=10Gi

# Server storage size  
SERVER_STORAGE_SIZE=20Gi

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Enable TLS/SSL (set to 'true' for production)
QB_ENABLE_TLS=false

# TLS certificate paths (when TLS enabled)
QB_TLS_CERT_PATH=/etc/ssl/certs/qb-server.crt
QB_TLS_KEY_PATH=/etc/ssl/private/qb-server.key

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================

# Log level (DEBUG, INFO, WARN, ERROR)
QB_LOG_LEVEL=INFO

# Enable health checks
QB_ENABLE_HEALTH_CHECKS=true

# Health check interval (seconds)
QB_HEALTH_CHECK_INTERVAL=30

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Backup storage path
BACKUP_PATH=./backups

# =============================================================================
# DEVELOPMENT/TESTING CONFIGURATION
# =============================================================================

# Enable debug mode (development only)
QB_DEBUG_MODE=false

# Skip vulnerability scanning (development only)
SKIP_SECURITY_SCAN=false

# Use local images instead of pulling from registry
USE_LOCAL_IMAGES=false